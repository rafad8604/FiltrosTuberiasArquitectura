@startuml ClasesArquitectura

' Diagrama de Clases - Arquitectura Pipes & Filters (solo CLI)

skinparam classAttributeIconSize 0

title Diagrama de clases CLI - MainPipeline

namespace inicio {
  class MainPipeline {
    + main(args : String[])
    --
    - construirEntrada(archivo : File, primerFiltroId : int) : datos.PaqueteDatos
    - leerDirectorio(directorio : File, filtroId : int) : datos.PaqueteDatos
    - guardarResultado(resultado : datos.PaqueteDatos, outputDir : File, filtroIds : List<int>)
    - mostrarAyuda() : void
  }
}

namespace motor {
  class PipelineManager {
    + ejecutar(entradaInicial : datos.PaqueteDatos, pasos : List<PasoFiltro>) : datos.PaqueteDatos
  }

  class PasoFiltro {
    - jarPath : String
    - argumentoExtra : String
  }
}

namespace datos {
  class PaqueteDatos {
    - tipo : TipoDato
    - datos : byte[]
    - lista : List<byte[]>
    - nombres : List<String>
    --
    + getTipo() : TipoDato
    + getDatos() : byte[]
    + getLista() : List<byte[]>
    + getNombres() : List<String>
    + aLista() : PaqueteDatos
    + primerElemento() : PaqueteDatos
    + setParametros(palabra : String) : void
  }

  enum TipoDato {
    TEXTO
    BINARIO
    BASE64
    IMAGEN
    PATH
    LISTA_TEXTO
    LISTA_BINARIO
    LISTA_BASE64
    LISTA_IMAGEN
  }

  class ProtocoloPipe {
    + leer(in : InputStream) : PaqueteDatos
    + escribir(out : OutputStream, datos : PaqueteDatos) : void
  }
}

namespace filtros {
  class CargarArchivoDeTextoStandalone
  class ConvertirTextoABinarioStandalone
  class FiltroImagenesStandalone
  class ConvertirBinarioABase64Standalone
  class ConvertirBase64ABinarioStandalone
  class EncriptarArchivoTextoSHA256Standalone
  class BuscarPalabraEnArchivoTextoStandalone
  class ListarPalabrasFrecuenciaDeOcurrenciaStandalone
}

' Relaciones principales CLI
inicio.MainPipeline --> motor.PipelineManager
inicio.MainPipeline --> datos.PaqueteDatos
inicio.MainPipeline --> datos.TipoDato

motor.PipelineManager "1" o-- "*" motor.PasoFiltro
motor.PipelineManager --> datos.ProtocoloPipe
motor.PipelineManager --> datos.PaqueteDatos

datos.PaqueteDatos --> datos.TipoDato
datos.ProtocoloPipe --> datos.PaqueteDatos

filtros.CargarArchivoDeTextoStandalone --> datos.ProtocoloPipe
filtros.ConvertirTextoABinarioStandalone --> datos.ProtocoloPipe
filtros.FiltroImagenesStandalone --> datos.ProtocoloPipe
filtros.ConvertirBinarioABase64Standalone --> datos.ProtocoloPipe
filtros.ConvertirBase64ABinarioStandalone --> datos.ProtocoloPipe
filtros.EncriptarArchivoTextoSHA256Standalone --> datos.ProtocoloPipe
filtros.BuscarPalabraEnArchivoTextoStandalone --> datos.ProtocoloPipe
filtros.ListarPalabrasFrecuenciaDeOcurrenciaStandalone --> datos.ProtocoloPipe

@enduml

