@startuml ClasesArquitectura

' Diagrama de Clases - Arquitectura Pipes & Filters

skinparam classAttributeIconSize 0

title Diagrama de clases principal - Tuberías y Filtros

namespace presentacion {
  class VistaEscritorio {
    - gestorTuberias : motor.GestorTuberias
    --
    + configurarTuberia()
    + ejecutarTuberia()
  }
}

namespace inicio {
  class InicioAplicacion {
    + main(args : String[])
  }
}

namespace fabrica {
  class FabricaFiltros {
    - instancia : FabricaFiltros
    --
    + getInstancia() : FabricaFiltros
    + crearFiltro(id : int) : interfaces.IFiltro
    + crearGestorTuberias() : motor.GestorTuberias
  }
}

namespace motor {
  class GestorTuberias {
    - tuberias : List<Tuberia>
    --
    + crearTuberia(nombre : String) : Tuberia
    + ejecutar(nombre : String, entrada : datos.PaqueteDatos) : datos.PaqueteDatos
  }

  class Tuberia {
    - nombre : String
    - filtros : List<interfaces.IFiltro>
    --
    + agregarFiltro(filtro : interfaces.IFiltro) : boolean
    + ejecutar(entradaInicial : datos.PaqueteDatos) : datos.PaqueteDatos
  }
}

namespace datos {
  class PaqueteDatos {
    - tipo : TipoDato
    - contenido : Object
    --
    + getTipo() : TipoDato
    + getContenido() : Object
    + aLista() : PaqueteDatos
    + primerElemento() : PaqueteDatos
  }

  enum TipoDato {
    TEXTO
    BINARIO
    BASE64
    IMAGEN
    LISTA_TEXTO
    LISTA_BINARIO
    LISTA_BASE64
    LISTA_IMAGEN
  }
}

namespace interfaces {
  interface IFiltro {
    + getId() : int
    + getNombre() : String
    + getTipoEntrada() : datos.TipoDato
    + getTipoSalida() : datos.TipoDato
    + procesar(entrada : datos.PaqueteDatos) : datos.PaqueteDatos
  }

  interface IFiltroMultiple {
    + getId() : int
    + getNombre() : String
    + getTipoEntrada() : datos.TipoDato
    + getTipoSalida() : datos.TipoDato
    + procesarLista(entrada : datos.PaqueteDatos) : datos.PaqueteDatos
  }
}

namespace filtros {
  class CargarArchivoDeTexto
  class ConvertirTextoABinario
  class FiltroImagenes
  class ConvertirBinarioABase64
  class ConvertirBase64ABinario
  class EncriptarArchivoTextoSHA256
  class BuscarPalabraEnArchivoTexto
  class ListarPalabrasFrecuenciaDeOcurrencia
}

' Relaciones principales
inicio.InicioAplicacion --> presentacion.VistaEscritorio
presentacion.VistaEscritorio --> motor.GestorTuberias
presentacion.VistaEscritorio --> fabrica.FabricaFiltros

fabrica.FabricaFiltros --> motor.GestorTuberias
fabrica.FabricaFiltros --> motor.Tuberia
fabrica.FabricaFiltros --> interfaces.IFiltro
fabrica.FabricaFiltros --> interfaces.IFiltroMultiple

motor.GestorTuberias "1" o-- "*" motor.Tuberia
motor.Tuberia "1" o-- "*" interfaces.IFiltro
motor.Tuberia --> datos.PaqueteDatos
datos.PaqueteDatos --> datos.TipoDato

interfaces.IFiltro --> datos.PaqueteDatos
interfaces.IFiltroMultiple --> datos.PaqueteDatos

filtros.CargarArchivoDeTexto ..|> interfaces.IFiltro
filtros.ConvertirTextoABinario ..|> interfaces.IFiltro
filtros.FiltroImagenes ..|> interfaces.IFiltroMultiple
filtros.ConvertirBinarioABase64 ..|> interfaces.IFiltroMultiple
filtros.ConvertirBase64ABinario ..|> interfaces.IFiltro
filtros.EncriptarArchivoTextoSHA256 ..|> interfaces.IFiltro
filtros.BuscarPalabraEnArchivoTexto ..|> interfaces.IFiltro
filtros.ListarPalabrasFrecuenciaDeOcurrencia ..|> interfaces.IFiltro

@enduml

