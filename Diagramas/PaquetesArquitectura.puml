@startuml PaquetesArquitectura

' Diagrama de Paquetes - Arquitectura Pipes & Filters

title Diagrama de Paquetes - Tuberías y Filtros (CLI)

left to right direction

skinparam packageStyle rectangle
skinparam shadowing false
skinparam BackgroundColor #f8f8f8
skinparam defaultTextAlignment center

skinparam package {
  BorderColor #555555
  BackgroundColor #EFEFEF
}

skinparam note {
  BackgroundColor #FFFFFF
}

' Paquete raíz que representa el proyecto CLI
package "tuberias_filtros" {

  package "inicio" #E3F2FD {
    [MainPipeline]
  }

  package "motor" #FFF3E0 {
    [PipelineManager]
  }

  package "datos" #E8F5E9 {
    [PaqueteDatos]
    [TipoDato]
  }

  package "filtros" #FAFAFA {
    [CargarArchivoDeTextoStandalone]
    [ConvertirTextoABinarioStandalone]
    [FiltroImagenesStandalone]
    [ConvertirBinarioABase64Standalone]
    [ConvertirBase64ABinarioStandalone]
    [EncriptarArchivoTextoSHA256Standalone]
    [BuscarPalabraEnArchivoTextoStandalone]
    [ListarPalabrasFrecuenciaDeOcurrenciaStandalone]
  }
}

' Dependencias principales entre paquetes (CLI)
inicio -[#gray;dashed]-> motor        : «usa»
inicio -[#gray;dashed]-> datos        : «importa»

motor -[#gray;dashed]-> datos         : «usa»

filtros -[#gray;dashed]-> datos        : «importa»

' Enlaces ocultos para ordenar los paquetes y reducir cruces
inicio -[hidden]-> motor
motor -[hidden]-> datos
datos -[hidden]-> filtros

' Leyenda
legend right
|= Estructura |= Significado |
| paquete raíz (tuberias_filtros) | proyecto CLI |
| subpaquetes (inicio, motor, datos, filtros) | capas lógicas |
| paquete filtros | filtros standalone (JAR) ejecutados por SO |
| flecha discontinua | dependencia entre paquetes |
end legend

@enduml

